# Copy to .env and adjust. In development every value has a working default.

# MongoDB connection string.
MONGODB_URI="mongodb://127.0.0.1:27017/realtyconnect"

# Port of the API server (the Vite dev server proxies /api to it).
PORT=4000

# Secret used to sign access tokens. REQUIRED in production; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""

# First administrator account, created at startup if it does not exist yet.
# The password must satisfy the platform policy (12+ chars, upper, lower, digit, special).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Demo personas (builder@realtyconnect.com, admin@realtyconnect.com, ...) that all share DEMO_PASSWORD,
# which the sign-in screen fills in for you. On by default in development, off in production.
# Never enable on a server that holds real data.
# SEED_DEMO_USERS=true
# DEMO_PASSWORD="RealtyConnect@2026"

# Where uploaded documents are written.
# UPLOAD_DIR="server/uploads"

# Set to true when the API runs behind a reverse proxy (default: true in production).
# TRUST_PROXY=true
